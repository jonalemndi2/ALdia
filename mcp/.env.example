# Ejemplo de configuracion del servidor MCP de ALdia.
# Copie este archivo a .env (NO se versiona) o defina las variables en la
# configuracion del cliente MCP. Nunca escriba credenciales reales aca.

# URL donde corre el backend de ALdia.
ALDIA_URL=http://127.0.0.1:8000

# Usuario del sistema con el que operara el asistente.
# Recomendado: un usuario de rol acotado (por ejemplo "caja"), NO el administrador.
ALDIA_USER=cambiar

# Contrasena de ese usuario.
ALDIA_PASSWORD=cambiar

# Timeout de las peticiones HTTP, en segundos (opcional).
ALDIA_TIMEOUT=30

# ─── Origen de las operaciones (trazabilidad multicanal) ───
# Identifica POR DONDE entra la operacion. Cada canal deberia correr su propia
# instancia del servidor MCP, con su propio usuario de ALdia y su propio rol.
#   openclaw  -> asistente personal del dueno (rol operativo)
#   whatsapp  -> canal de consulta (rol auditor: lee todo, no escribe nada)
#   telegram  -> idem
ALDIA_CANAL=openclaw

# Nombre del agente, para poder distinguirlo en la auditoria.
ALDIA_AGENTE=aldia-mcp

# QUIEN pidio cada operacion (el numero de WhatsApp, el user_id de Telegram) se
# fija por llamada desde el codigo del canal, con `cliente.fijar_solicitante()`.
# NO se configura aca, y NUNCA debe salir de lo que el usuario escriba en el
# mensaje: tiene que venir del canal, que es lo unico verificable.
